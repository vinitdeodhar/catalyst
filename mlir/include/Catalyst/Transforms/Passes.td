#ifndef CATALYST_PASSES
#define CATALYST_PASSES

include "mlir/Pass/PassBase.td"

def DetensorizeFunctionBoundaryPass : Pass<"detensorize-function-boundary"> {
    let summary = "Detensorize across function boundary.";

    let dependentDialects = [
        "tensor::TensorDialect",
    ];
}

def DetensorizeSCFPass : Pass<"detensorize-scf"> {
    let summary = "Detensorize for, if, while operations from the SCF dialect.";

    let dependentDialects = [
        "tensor::TensorDialect"
    ];
}

def ArrayListToMemRefPass : Pass<"convert-arraylist-to-memref"> {
    let summary = "Lower array list operations to memref operations.";
    let description = [{
        This pass implements dynamically resizable array lists via lowering
        them to mutable memrefs.
    }];

    let dependentDialects = [
        "mlir::arith::ArithDialect",
        "mlir::func::FuncDialect",
        "mlir::memref::MemRefDialect",
        "mlir::scf::SCFDialect"
    ];
}

def CatalystConversionPass : Pass<"convert-catalyst-to-llvm"> {
    let summary = "Lower catalyst utility operations to the LLVM dialect.";

    let dependentDialects = [
        "mlir::func::FuncDialect",
        "mlir::LLVM::LLVMDialect",
    ];
}

def QnodeToAsyncLoweringPass : Pass<"qnode-to-async-lowering"> {
    let summary = "Lower Qnode func and call operations to async func and call operations.";

    let dependentDialects = [
        "async::AsyncDialect",
        "mlir::memref::MemRefDialect",
        "bufferization::BufferizationDialect"
    ];
}

def DisableAssertionPass : Pass<"disable-assertion"> {
    let summary = "Disable all catalyst_assertions.";
}

def AddExceptionHandlingPass : Pass<"add-exception-handling"> {
    let summary = "Adds exception handling for async qnodes.";

    let description = [{
        This pass will set async tokens and async values to be an error
        when qnodes raise an exception.

        Besides that, it will change the logic generated by the async dialect
        that aborts the execution and instead will call a function in the runtime
        that will generate an error.
    }];

    let dependentDialects = [
        "mlir::LLVM::LLVMDialect",
    ];

    let options = [
        Option<
            /*C++ var name=*/"stopAfterStep",
            /*CLI arg name=*/"stop-after-step",
            /*type=*/"int",
            /*default=*/"0",
            /*description=*/
            "Useful for tests. This will stop the execution of the transformation after a "
            "N step has been executed. Defaults to 0 which is equivalent to running "
            "all steps to completion."
        >
    ];
}

def GEPInboundsPass : Pass<"gep-inbounds"> {
    let summary = "Mark GEPOp inbounds.";
}

def MemrefCopyToLinalgCopyPass : Pass<"memrefcpy-to-linalgcpy"> {
    let summary = "Switch memref.copy to linalg.copy when the layout is not the identity.";

    let dependentDialects = [
        "memref::MemRefDialect",
        "linalg::LinalgDialect"
    ];
}

def RegisterInactiveCallbackPass : Pass<"register-inactive-callback", "ModuleOp"> {
    let summary = "Register `__catalyst_inactive_callback` as inactive with Enzyme";

    let dependentDialects = [
        "mlir::LLVM::LLVMDialect"
    ];
}

def MemrefToLLVMWithTBAAPass : Pass<"memref-to-llvm-tbaa", "mlir::ModuleOp"> {
  let summary = "Lower the memref load and store operation to LLVM and add the TBAA tags.";

  let dependentDialects = [
        "mlir::LLVM::LLVMDialect"
  ];
}

def MarkEntryPointArgsNonWritablePass : Pass<"mark-entry-point-args-non-writable", "mlir::ModuleOp"> {
    let summary = "Mark entry-point arguments as non-writable for bufferization.";

    let dependentDialects = [
        "bufferization::BufferizationDialect",
        "func::FuncDialect"
    ];
}

def ApplyTransformSequencePass : Pass<"apply-transform-sequence"> {
    let summary = "Apply the passes scheduled with the transform dialect.";
}

def InlineNestedModulePass : Pass<"inline-nested-module"> {
    let summary = "Inline nested modules with qnode attribute.";

    let dependentDialects = [
        "mlir::func::FuncDialect"
    ];

    let options = [
        Option<
            /*C++ var name=*/"stopAfterStep",
            /*CLI arg name=*/"stop-after-step",
            /*type=*/"int",
            /*default=*/"0",
            /*description=*/
            "Useful for tests. This will stop the pass after the given step has been executed "
            "(steps run from 1 to 5). Defaults to 0 which is equivalent to running "
            "all steps to completion."
        >
    ];
}


// Legacy buffer deallocation pass.
//
// This pass has been modified from its original form in the LLVM project at
// https://github.com/llvm/llvm-project released under the Apache License, Version 2.0,
// with the following copyright notice:
//
//   * Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
//   * See https://llvm.org/LICENSE.txt for license information.
//   * SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

def BufferDeallocationPass : Pass<"buffer-deallocation", "func::FuncOp"> {
  let summary = "Adds all required dealloc operations for all allocations in "
                "the input program";
  let description = [{
    This pass implements an algorithm to automatically introduce all required
    deallocation operations for all buffers in the input program. This ensures
    that the resulting program does not have any memory leaks.


    Input

    ```mlir
    #map0 = affine_map<(d0) -> (d0)>
    module {
      func.func @condBranch(%arg0: i1, %arg1: memref<2xf32>, %arg2: memref<2xf32>) {
        cf.cond_br %arg0, ^bb1, ^bb2
      ^bb1:
        cf.br ^bb3(%arg1 : memref<2xf32>)
      ^bb2:
        %0 = memref.alloc() : memref<2xf32>
        linalg.generic {
          indexing_maps = [#map0, #map0],
          iterator_types = ["parallel"]} %arg1, %0 {
        ^bb0(%gen1_arg0: f32, %gen1_arg1: f32):
          %tmp1 = exp %gen1_arg0 : f32
          linalg.yield %tmp1 : f32
        }: memref<2xf32>, memref<2xf32>
        cf.br ^bb3(%0 : memref<2xf32>)
      ^bb3(%1: memref<2xf32>):
        "memref.copy"(%1, %arg2) : (memref<2xf32>, memref<2xf32>) -> ()
        return
      }
    }

    ```

    Output

    ```mlir
    #map0 = affine_map<(d0) -> (d0)>
    module {
      func.func @condBranch(%arg0: i1, %arg1: memref<2xf32>, %arg2: memref<2xf32>) {
        cf.cond_br %arg0, ^bb1, ^bb2
      ^bb1:  // pred: ^bb0
        %0 = memref.alloc() : memref<2xf32>
        memref.copy(%arg1, %0) : memref<2xf32>, memref<2xf32>
        cf.br ^bb3(%0 : memref<2xf32>)
      ^bb2:  // pred: ^bb0
        %1 = memref.alloc() : memref<2xf32>
        linalg.generic {
          indexing_maps = [#map0, #map0],
          iterator_types = ["parallel"]} %arg1, %1 {
        ^bb0(%arg3: f32, %arg4: f32):
          %4 = exp %arg3 : f32
          linalg.yield %4 : f32
        }: memref<2xf32>, memref<2xf32>
        %2 = memref.alloc() : memref<2xf32>
        memref.copy(%1, %2) : memref<2xf32>, memref<2xf32>
        dealloc %1 : memref<2xf32>
        cf.br ^bb3(%2 : memref<2xf32>)
      ^bb3(%3: memref<2xf32>):  // 2 preds: ^bb1, ^bb2
        memref.copy(%3, %arg2) : memref<2xf32>, memref<2xf32>
        dealloc %3 : memref<2xf32>
        return
      }

    }
    ```

  }];
}

def ResourceAnalysisPass : Pass<"resource-analysis"> {
    let summary = "Track and report resource usage.";
    let description = [{
        This pass computes comprehensive resource metrics, including gate counts,
        measurements, qubit allocations, device name, as well as structured classical ops.
        For operations within the `Quantum`, `PBC`, and `MBQC` dialects,
        It leverages `ResourceAnalysis` to retrieve cached results and integrates directly
        with the MLIR Pass Statistics mechanism for reporting.

        Optionally, it can output the results as JSON to stdout or a file for
        consumption by the PennyLane frontend.

        Usage:
            quantum-opt input.mlir -resource-analysis -mlir-pass-statistics
            quantum-opt input.mlir -resource-analysis -resource-analysis-output-json=true
    }];

    let options = [
        Option<
            /*C++ var name=*/"outputJson",
            /*CLI arg name=*/"output-json",
            /*type=*/"bool",
            /*default=*/"false",
            /*description=*/"Output resource counts as JSON. Prints to stdout unless output-fname is set"
        >,
        Option<
            /*C++ var name=*/"outputFname",
            /*CLI arg name=*/"output-fname",
            /*type=*/"std::string",
            /*default=*/"",
            /*description=*/"The filename to save the output JSON to (only when output-json is true)"
        >
    ];
}


def RegisterDecompRuleResourcePass : Pass<"register-decomp-rule-resource"> {
    let summary = "Compute and register the resources of decomposition rules.";
    let description = [{
        This pass uses `ResourceAnalysisPass` to compute resource metrics of
        functions marked with the `target_gate` attribute, effectively
        filtering for decomposition rules.

        Note: This pass only applies to top level functions in the main module.

        Usage:
            quantum-opt input.mlir -register-decomp-rule-resource

        Input:

        ```mlir
        func.func @decomp_rule() attributes {target_gate="CustomGate"}  {
            %0 = quantum.alloc( 2) : !quantum.reg
            %1 = quantum.extract %0[ 0] : !quantum.reg -> !quantum.bit
            %2 = quantum.extract %0[ 1] : !quantum.reg -> !quantum.bit
            %3 = quantum.custom "Hadamard"() %1 : !quantum.bit
            %4 = quantum.custom "T"() %3 : !quantum.bit
            %5 = quantum.custom "S"() %2 : !quantum.bit
            %6:2 = quantum.custom "CNOT"() %4, %5 : !quantum.bit, !quantum.bit
            %7 = quantum.insert %0[ 0], %6#0 : !quantum.reg, !quantum.bit
            %8 = quantum.insert %7[ 1], %6#1 : !quantum.reg, !quantum.bit
            quantum.dealloc %8 : !quantum.reg
            return
        }
        ```

        Output:

        ```mlir
        func.func @decomp_rule() attributes {resources = {measurements = {}, num_alloc_qubits = 2 : i64, num_arg_qubits = 0 : i64, num_qubits = 2 : i64, operations = {"CNOT(2)" = 1 : i64, "Hadamard(1)" = 1 : i64, "S(1)" = 1 : i64, "T(1)" = 1 : i64}}, target_gate = "CustomGate"}  {
            %0 = quantum.alloc( 2) : !quantum.reg
            %1 = quantum.extract %0[ 0] : !quantum.reg -> !quantum.bit
            %2 = quantum.extract %0[ 1] : !quantum.reg -> !quantum.bit
            %3 = quantum.custom "Hadamard"() %1 : !quantum.bit
            %4 = quantum.custom "T"() %3 : !quantum.bit
            %5 = quantum.custom "S"() %2 : !quantum.bit
            %6:2 = quantum.custom "CNOT"() %4, %5 : !quantum.bit, !quantum.bit
            %7 = quantum.insert %0[ 0], %6#0 : !quantum.reg, !quantum.bit
            %8 = quantum.insert %7[ 1], %6#1 : !quantum.reg, !quantum.bit
            quantum.dealloc %8 : !quantum.reg
            return
        }
        ```
    }];
}

def ResourceBudgetToffoliDecompPass : Pass<"resource-budget-toffoli-decomp", "mlir::ModuleOp"> {
    let summary = "Resource-guided Toffoli gate decomposition into CNOT+H+T primitives.";
    let description = [{
        Uses per-function CNOT pressure estimates from ResourceAnalysis to decide
        whether to inline the standard 15-gate Toffoli decomposition
        (H×2 + CNOT×6 + T×4 + T†×3, no ancilla, no relative phase).

        CNOT pressure for a function = Σ (CNOT_count + 6 × Toffoli_count) over
        all reachable callees (using the flattened resource view). Functions with
        dynamic while-loops annotated with `estimated_iterations` include loop-body
        costs scaled by the estimate; unannotated while-loop bodies are excluded
        from the pressure calculation.

        Functions whose flattened pressure exceeds `cnot-threshold` have every
        `quantum.custom "Toffoli"` op replaced by its explicit 15-gate sequence.
        Inlining exposes gate boundaries — especially across loop-iteration edges
        after while-loop-peeling — to the cancel_inverses and merge_rotations
        passes, enabling real gate-count reductions.

        Toffoli ops with extra control qubits (in_ctrl_qubits non-empty) are
        left untouched; they require higher-order decompositions.

        Recommended pipeline position: after while-loop-peeling and before
        cancel-inverses / merge-rotations.

        Usage:
            quantum-opt input.mlir --resource-budget-toffoli-decomp
            quantum-opt input.mlir --resource-budget-toffoli-decomp="cnot-threshold=12"
    }];

    let options = [
        Option<
            /*C++ var name=*/"cnotThreshold",
            /*CLI arg name=*/"cnot-threshold",
            /*type=*/"int64_t",
            /*default=*/"20",
            /*description=*/"Decompose Toffoli gates in functions whose estimated CNOT "
                            "pressure (CNOT_count + 6*Toffoli_count) exceeds this value."
        >
    ];
}

def GateCounterInstrumentationPass : Pass<"gate-counter-instrumentation", "mlir::ModuleOp"> {
    let summary = "Insert per-gate runtime counters into quantum circuits.";
    let description = [{
        Transforms a module containing quantum.custom and quantum.measure ops to
        add memref.global i64 counters — one per unique (gate_name, num_wires)
        pair. After each such op an increment sequence (load / addi / store) is
        inserted, so the counters accumulate the actual number of gate
        applications during a run of the compiled circuit.

        Intended use: add to the end of QuantumCompilationStage via
        insert_pass_after so counters survive the full lowering chain and become
        addressable LLVM globals ([1 x i64]) in the compiled shared library.

        After execution the Python layer reads counter values via ctypes:
            count = (ctypes.c_int64 * 1).in_dll(lib, "__gate_ctr_T_1")[0]

        A JSON manifest mapping gate_label -> symbol_name is written to
        `manifest-file` so the Python side knows which symbols to look up.
    }];

    let options = [
        Option<
            "manifestFile",
            "manifest-file",
            "std::string",
            "\"\"",
            "Path to write the gate-label->counter-symbol JSON manifest"
        >
    ];
}

def WhileLoopPeelingPass : Pass<"while-loop-peeling", "func::FuncOp"> {
    let summary = "Peel k iterations of while loops annotated with estimated_iterations.";
    let description = [{
        For each scf.while op carrying an `estimated_iterations = k` IntegerAttr,
        this pass emits k straight-line copies of the loop body — each guarded by
        an inlined copy of the condition — before a residual while loop.

        The residual while retains the original before/after regions but the
        `estimated_iterations` attribute is removed, leaving the residual
        unconditionally dynamic.

        Peeling benefits:
          - Exposes k flat iterations to MLIR's optimizer (gate cancellation,
            CSE, constant folding across iteration boundaries).
          - Lets `resource-analysis` see the first k iterations as static code.

        Usage:
            quantum-opt input.mlir --while-loop-peeling

        Only scf.while ops with `estimated_iterations` are affected; all other
        ops are left unchanged.
    }];

    let dependentDialects = [
        "mlir::scf::SCFDialect",
    ];

    let options = [
        Option<
            "peelFactor",
            "peel-factor",
            "int64_t",
            "-1",
            "Override iterations to peel for all loops. -1 = use each loop's estimated_iterations."
        >
    ];
}

def DepthBoundingPass : Pass<"depth-bounding", "func::FuncOp"> {
    let summary = "Bound while-loop depth using a max_iterations counter.";
    let description = [{
        For each scf.while op carrying a `max_iterations = N` IntegerAttr,
        this pass adds an i64 counter to the loop-carried values and ANDs the
        original loop condition with `counter < N`. This guarantees the loop
        terminates within N iterations regardless of its original condition.

        The counter is initialised to 0 and incremented each time the after
        region executes. The `max_iterations` attribute is consumed and removed.

        N is typically ceil(E[k] + c·σ), where E[k] and σ come from the
        profile-guided resource estimator, so the loop is cut off at a
        confidence-bounded depth while leaving the circuit correct with
        probability ≥ 1 − ε(c).

        Usage:
            quantum-opt input.mlir --depth-bounding
    }];

    let dependentDialects = [
        "mlir::arith::ArithDialect",
        "mlir::scf::SCFDialect",
    ];
}

def EmptyPass : Pass<"empty"> {
    let summary = "Empty pass that does nothing.";

    let options = [
        Option<
            /*C++ var name=*/"key",
            /*CLI arg name=*/"key",
            /*type=*/"std::string",
            /*default=*/"\"\"",
            /*description=*/
            "Useful for storing metadata about the pass for inspectability."
        >
    ];
}

def WidthGuardedMcxDecompPass : Pass<"width-guarded-mcx-decomp", "mlir::ModuleOp"> {
    let summary = "Cost-gated runtime dispatch between two multi-controlled-X decompositions.";
    let description = [{
        For an `scf.for` with a RUNTIME trip count whose body applies a
        multi-controlled `quantum.custom "PauliX"` (c controls), this pass emits a
        symbolic, runtime-evaluated guard that dispatches between two decompositions
        of the body's MCX:

          - ancilla-free : O(c^2) two-qubit gates, 0 ancillas (native op kept).
          - V-chain      : 2c-3 Toffolis on c-2 clean ancillas, i.e. O(c) gates.

        ResourceAnalysis classifies the loop as dynamic (runtime bound, so the total
        cost is symbolic in the bound) and provides the per-iteration body. The pass
        then materializes, in IR, the SYMBOLIC gate saving as a function of the
        runtime bound N and guards on it:

            saving(N) = (g_af(c) - g_vc(c)) * trip(N)
            scf.if saving(N) > cost-budget { V-chain loop } else { ancilla-free loop }

        where trip(N) = ceildiv(ub-lb, step) is built from the loop operands. This is
        a qubits-vs-gates trade evaluated at runtime: spend the V-chain's c-2 clean
        ancillas only when the loop is long enough that the accumulated gate saving
        exceeds `cost-budget`. Both branches are extensionally equal.

        Static (compile-time-constant) loops are skipped -- their decision is not
        symbolic. Only positive-control single-target PauliX with c >= 3 is handled.

        Usage:
            quantum-opt input.mlir --width-guarded-mcx-decomp="cost-budget=4000"
    }];

    let options = [
        Option<
            /*C++ var name=*/"costBudget",
            /*CLI arg name=*/"cost-budget",
            /*type=*/"int64_t",
            /*default=*/"0",
            /*description=*/"Dispatch to the V-chain loop when the symbolic per-loop gate "
                            "saving (g_af - g_vc) * trip(N) exceeds this budget."
        >
    ];
}
#endif // CATALYST_PASSES
