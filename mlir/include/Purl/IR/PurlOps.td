#ifndef PURL_OPS
#define PURL_OPS

include "mlir/IR/BuiltinTypes.td"
include "mlir/IR/EnumAttr.td"
include "mlir/IR/OpBase.td"
include "mlir/Interfaces/SideEffectInterfaces.td"

include "Quantum/IR/QuantumDialect.td"
include "Quantum/IR/QuantumTypes.td"
include "Purl/IR/PurlDialect.td"

//===----------------------------------------------------------------------===//
// Purl attributes
//===----------------------------------------------------------------------===//

// Cut strategy chosen by --purl (baked into the op; --purl-lower-qcut switches
// on it). refresh = gamma=1 deterministic refresh of a proven known state;
// knit = gamma=4 quasi-probability cut.
def PurlStrategy : I32EnumAttr<"Strategy", "Purl cut strategy",
    [
        I32EnumAttrCase<"refresh", 1>,
        I32EnumAttrCase<"knit",    2>,
    ]> {
    let cppNamespace = "catalyst::purl";
    let genSpecializedAttr = 0;
}
def PurlStrategyAttr : EnumAttr<Purl_Dialect, PurlStrategy, "strategy">;

// Single-qubit Pauli label: the knit measurement `axis`, or the refresh
// KnownPauli `pauli_correction` (`none` = identity).
def PurlPauli : I32EnumAttr<"Pauli", "Single-qubit Pauli label",
    [
        I32EnumAttrCase<"none", 0>,
        I32EnumAttrCase<"X",    1>,
        I32EnumAttrCase<"Y",    2>,
        I32EnumAttrCase<"Z",    3>,
    ]> {
    let cppNamespace = "catalyst::purl";
    let genSpecializedAttr = 0;
}
def PurlPauliAttr : EnumAttr<Purl_Dialect, PurlPauli, "pauli">;

//===----------------------------------------------------------------------===//
// Purl operations
//===----------------------------------------------------------------------===//

def YieldOp : Purl_Op<"yield", [Pure, ReturnLike, Terminator,
        ParentOneOf<["QCutOp"]>]> {
    let summary = "Terminate a purl.qcut `prep` region, yielding the prepared qubit.";
    let arguments = (ins QubitType:$qubit);
    let assemblyFormat = [{ $qubit attr-dict `:` type($qubit) }];
}

def QCutOp : Purl_Op<"qcut", [SingleBlockImplicitTerminator<"YieldOp">]> {
    let summary = "Abstract single-wire cut of a carried loop qubit (spec 3.7).";
    let description = [{
        Emitted by `--purl` inside the periodic `if counter == C` cut guard, and
        expanded by `--purl-lower-qcut`. The op is self-contained: every decision
        is baked in as an operand/attribute/region, so the lowering does no
        analysis.

        `strategy = refresh` (gamma=1): measure + reset the carried wire and replay
        the `prep` region to re-prepare the known |psi0> (applying
        `pauli_correction` for a KnownPauli). No weight.

        `strategy = knit` (gamma=4): threads an f64 quasi-probability weight
        (`in_weight` -> `out_weight`) and lowers to the sampled cut in the `axis`
        eigenbasis (`prep` is generated by the lowering from `axis`, so it may be
        empty here).

        Verifier: refresh carries no weight; knit carries exactly one f64 weight
        in and out.
    }];

    let arguments = (ins
        QubitType:$in_qubit,
        Optional<F64>:$in_weight,
        PurlStrategyAttr:$strategy,
        DefaultValuedAttr<PurlPauliAttr, "::catalyst::purl::Pauli::Z">:$axis,
        DefaultValuedAttr<PurlPauliAttr, "::catalyst::purl::Pauli::none">:$pauli_correction
    );
    let results = (outs
        QubitType:$out_qubit,
        Optional<F64>:$out_weight
    );
    let regions = (region SizedRegion<1>:$prep);

    let hasVerifier = 1;
}

#endif // PURL_OPS
